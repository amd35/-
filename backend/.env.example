# Copy to .env for local runs outside the platform (values are yours, never committed).
# The Base44 sandbox delivers SECRET_KEY / ADMIN_PASSWORD through the managed env
# file (/run/base44/app.env); local infrastructure credentials are generated in
# docker-compose.base44.yml.

# --- core ---
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ACCESS_TOKEN_DAYS=30
DATABASE_URL=postgresql+psycopg://app:app_dev_password@db:5432/app
MEDIA_DIR=/data/media
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# --- email (verification codes / password reset) ---
# Without these the code is written to the API log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- payments (Stripe) ---
# Stripe does not support IQD: prices are displayed in IQD and charged in USD.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- voice (RTC) ---
# STUN alone works on the same network. Calls between mobile networks need TURN:
# either your own coturn (TURN_URL / TURN_USERNAME / TURN_CREDENTIAL) or Cloudflare's
# TURN service, where these two keys are enough (credentials are minted per request).
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_CREDENTIAL_TTL=86400
