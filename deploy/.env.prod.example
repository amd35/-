# Copy this file to deploy/.env, fill in the values, and never commit it.
#   cp deploy/.env.prod.example deploy/.env
# Generate strong values with:  openssl rand -hex 32

# --- public hostnames (DNS A records must point at the VPS before first start) ---
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com

# --- database (local compose service; pick your own password) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=app

# --- core ---
SECRET_KEY=change-me-long-random
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-long-random
ACCESS_TOKEN_DAYS=30
MAX_UPLOAD_MB=5
# Keep 1: the realtime hub lives in process memory (see deploy/DEPLOY_VPS.md).
API_WORKERS=1

# --- email (verification codes / password reset) ---
# Without these the code is written to the API log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- payments (Stripe; webhook: https://APP_DOMAIN/api/payments/stripe/webhook) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- voice (RTC) ---
STUN_URL=stun:stun.l.google.com:19302
# Either your own coturn (TURN_URL=turn:APP_DOMAIN:3478 with the two values below)
# or Cloudflare TURN (the two CLOUDFLARE_* keys, no server to run).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_CREDENTIAL_TTL=86400

# --- only needed when starting the optional "turn" profile ---
TURN_REALM=yalla-lohan
# The VPS public IP address (coturn must advertise it to clients).
TURN_EXTERNAL_IP=
