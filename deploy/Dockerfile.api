# Production image for the FastAPI backend (code baked in, no bind mounts).
# Built from the repository root so `backend/` can be copied in:
#   docker build -f deploy/Dockerfile.api .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements.txt ./requirements.txt
RUN pip install --root-user-action=ignore -r ./requirements.txt

COPY backend/ /app/

EXPOSE 8000

# One worker by default on purpose: the realtime hub (rooms, games, direct
# messages) and the rate limiter live in process memory, so a second worker
# would silently split connected clients. Scale out only after moving the hub
# to Redis (see deploy/DEPLOY_VPS.md).
CMD ["sh", "-ec", "exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${API_WORKERS:-1} --proxy-headers --forwarded-allow-ips=*"]
